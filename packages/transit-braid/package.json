{
  "name": "transit-braid",
  "version": "0.1.0",
  "description": "Side-by-side transit lines for web maps: overlapping route polylines in, bundled parallel lines out.",
  "keywords": [
    "bus",
    "deck.gl",
    "geojson",
    "map",
    "maplibre",
    "transit",
    "webassembly"
  ],
  "homepage": "https://github.com/shakedk/transit-braid#readme",
  "bugs": {
    "url": "https://github.com/shakedk/transit-braid/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shakedk/transit-braid.git",
    "directory": "packages/transit-braid"
  },
  "files": [
    "dist",
    "wasm/transit_braid_wasm.js",
    "wasm/transit_braid_wasm.d.ts",
    "wasm/transit_braid_wasm_bg.wasm"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./node": "./src/node.ts",
    "./inline": {
      "types": "./src/inline.ts",
      "default": "./dist/inline.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "browser": "./dist/index.js",
        "node": "./dist/node.js",
        "default": "./dist/index.js"
      },
      "./node": {
        "types": "./dist/node.d.ts",
        "default": "./dist/node.js"
      },
      "./inline": {
        "types": "./dist/inline.d.ts",
        "browser": "./dist/inline.js",
        "node": "./dist/node.js",
        "default": "./dist/inline.js"
      },
      "./package.json": "./package.json"
    },
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json && vite build"
  },
  "devDependencies": {
    "vite": "^8.3.8"
  },
  "engines": {
    "node": ">=24"
  }
}
